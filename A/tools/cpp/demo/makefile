all:demo demo1 kehuduan111 fuwuduan111
demo:demo.cpp
	g++ -g -o demo demo.cpp -I/A/public /A/public/mpublic.cpp

demo1:demo1.cpp
	g++ -g -o demo1 demo1.cpp -I/A/public /A/public/mpublic.cpp

